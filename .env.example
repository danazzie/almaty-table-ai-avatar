# Copy to .env and fill in real keys. Never commit .env.

# OpenAI (LLM, vision, Whisper ASR)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# fal.ai (voice clone, TTS, avatar video)
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:yyyy

# MiniMax cloned voice id (run `python voice/clone.py` once; it is saved to voice_id.txt)
MINIMAX_VOICE_ID=

# Paid steps — keep off until MCP + LLM work
ENABLE_TTS=false
ENABLE_AVATAR=false

# Optional: public URLs if you already host assets
AVATAR_PHOTO_URL=
VOICE_SAMPLE_URL=
